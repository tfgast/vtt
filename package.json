{
  "name": "a-table-of-dumb-objects",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "dev": "pnpm --filter @vtt/ui dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "serve": "node --import tsx packages/authority/src/bin/serve.ts",
    "start": "node --import tsx packages/authority/src/bin/start.ts",
    "mcp": "node --import tsx packages/authority/src/bin/mcp.ts",
    "fixtures:prepped": "VTT_WRITE_PREPPED_TABLE=1 vitest run packages/ui/test/walkthrough/prepped-table.test.tsx"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
