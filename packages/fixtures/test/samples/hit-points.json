{
  "title": "Hit points follow damage until overridden",
  "source": "Hit points",
  "description": "hp is a formula over max_hp and damage_taken. A hand override freezes it and marks it; clearing the override makes it follow its inputs again. Undo reverses the clear.",
  "setup": {
    "boards": [{ "id": "table", "name": "Table" }],
    "characters": ["aldric"],
    "objects": [
      {
        "id": "aldric",
        "tag": ["pc"],
        "shape": { "type": "circle", "radius": 0.5 },
        "placement": { "board": "table", "position": [3, 4] },
        "cells": {
          "name": { "type": "text", "value": "Aldric" },
          "max_hp": { "type": "number", "value": 27 },
          "damage_taken": { "type": "number", "value": 0 },
          "hp": { "type": "formula", "source": "max_hp - damage_taken" }
        }
      }
    ]
  },
  "dice": [],
  "expect": [
    {
      "type": "cell",
      "object": "aldric",
      "cell": "hp",
      "value": { "type": "number", "value": 27 }
    },
    { "type": "override", "object": "aldric", "cell": "hp", "overridden": false },
    { "type": "log_groups", "count": 0 }
  ],
  "steps": [
    {
      "actor": "gm",
      "note": "Aldric takes 5 damage.",
      "do": {
        "type": "set",
        "object": "aldric",
        "cell": "damage_taken",
        "value": { "type": "number", "value": 5 }
      },
      "expect": [
        {
          "type": "cell",
          "object": "aldric",
          "cell": "hp",
          "value": { "type": "number", "value": 22 }
        },
        { "type": "log_groups", "count": 1 },
        {
          "type": "log_includes",
          "group": -1,
          "effect": {
            "type": "write",
            "object": "aldric",
            "cell": "damage_taken",
            "value": { "type": "number", "value": 5 }
          }
        }
      ]
    },
    {
      "actor": "gm",
      "note": "The GM types 30 over the hp formula.",
      "do": {
        "type": "override",
        "object": "aldric",
        "cell": "hp",
        "value": { "type": "number", "value": 30 }
      },
      "expect": [
        {
          "type": "cell",
          "object": "aldric",
          "cell": "hp",
          "value": { "type": "number", "value": 30 }
        },
        { "type": "override", "object": "aldric", "cell": "hp", "overridden": true }
      ]
    },
    {
      "actor": "gm",
      "note": "Further damage does not show while hp is overridden.",
      "do": {
        "type": "set",
        "object": "aldric",
        "cell": "damage_taken",
        "value": { "type": "number", "value": 10 }
      },
      "expect": [
        {
          "type": "cell",
          "object": "aldric",
          "cell": "hp",
          "value": { "type": "number", "value": 30 }
        },
        { "type": "override", "object": "aldric", "cell": "hp", "overridden": true }
      ]
    },
    {
      "actor": "gm",
      "note": "Clearing the override makes hp follow its inputs again.",
      "do": { "type": "clear_override", "object": "aldric", "cell": "hp" },
      "expect": [
        {
          "type": "cell",
          "object": "aldric",
          "cell": "hp",
          "value": { "type": "number", "value": 17 }
        },
        { "type": "override", "object": "aldric", "cell": "hp", "overridden": false }
      ]
    },
    {
      "actor": "gm",
      "note": "Undo reverses the clear; the override and its marker come back.",
      "do": { "type": "undo" },
      "expect": [
        {
          "type": "cell",
          "object": "aldric",
          "cell": "hp",
          "value": { "type": "number", "value": 30 }
        },
        { "type": "override", "object": "aldric", "cell": "hp", "overridden": true },
        {
          "type": "cell",
          "object": "aldric",
          "cell": "damage_taken",
          "value": { "type": "number", "value": 10 }
        },
        { "type": "log_groups", "count": 5 }
      ]
    }
  ]
}
