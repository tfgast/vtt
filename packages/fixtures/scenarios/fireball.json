          "object": "row_g1",
          "cell": "passed",
          "value": {
            "type": "boolean",
            "value": false
          },
          "note": "passed = save_roll + save_bonus >= card.dc: empty acts as 0 (FORMULAS §2.1), 0 + 2 >= 14 is false."
