      "object": "aldric_binder",
      "contents": ["fireball", "save_row_t"],
      "note": "The card template and, outside its subtree, the row template sit in Aldric's binder."
    },
    {
      "type": "log_groups",
      "count": 0,
      "note": "Nothing has happened yet."
    }
  ],
  "steps": [
    {
      "actor": "aldric",
      "note": "Group 0. Aldric spawns the Fireball card into his binder with caster set; the card's zone is copied with it.",
      "do": {
        "type": "spawn",
        "template": "fireball",
        "to": {
          "type": "container",
          "container": "aldric_binder",
          "index": 0
        },
        "cells": {
          "caster": {
            "type": "ref",
            "object": "aldric"
          }
        },
        "as": "fb1",
        "owned": {
          "fireball_zone": "zone1"
        }
      },
      "expect": [
        {
          "type": "container",
          "object": "fb1",
          "container": "aldric_binder",
          "index": 0,
          "note": "The spawn destination is index 0 of Aldric's binder."
        },
        {
          "type": "contents",
          "object": "aldric_binder",
          "contents": ["fb1", "fireball", "save_row_t"],
          "note": "The templates stay where they were; only the copy is added."
        },
        {
          "type": "contents",
          "object": "fb1",
          "contents": ["zone1"],
          "note": "\"Spawning the Fireball card copies the card and its zone.\""
        },
        {
          "type": "cell",
          "object": "fb1",
          "cell": "zone",
          "value": {
            "type": "ref",
            "object": "zone1"
          },
          "note": "\"the card's zone reference is remapped to the new zone\" (DESIGN §4.1: references among the copied objects are remapped to the copies)."
        },
        {
          "type": "cell",
          "object": "fb1",
          "cell": "save_row",
          "value": {
            "type": "ref",
            "object": "save_row_t"
