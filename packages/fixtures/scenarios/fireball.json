            "value": "Aldric's binder"
          },
          "owner": {
            "type": "ref",
            "object": "aldric"
          }
        }
      },
      {
        "id": "fireball",
        "note": "FORMULAS §10: the card template owns the zone in its contents. save_row is the reference the prose's spawn(save_row, this, ...) needs but does not list (FIXTURES §9).",
        "is_template": true,
        "tag": ["card", "fireball"],
        "contents": ["fireball_zone"],
        "cells": {
          "name": {
            "type": "text",
            "value": "Fireball"
          },
          "caster": {
            "type": "empty"
          },
          "zone": {
            "type": "ref",
            "object": "fireball_zone"
          },
          "save_row": {
            "type": "ref",
            "object": "save_row_t"
          },
          "dc": {
            "type": "formula",
            "source": "caster.spell_dc"
          },
          "damage": {
            "type": "empty"
          },
          "locked": {
            "type": "boolean",
            "value": false
          },
          "applied": {
            "type": "boolean",
            "value": false
          },
          "targets": {
            "type": "formula",
            "source": "contents(zone).where(tag has \"creature\")"
          },
          "rows": {
            "type": "formula",
            "source": "contents.where(tag has \"save_row\")"
          }
        },
        "actions": [
          {
            "name": "Lock targets",
            "when": "not locked",
            "steps": [
              "each(targets, spawn(save_row, this, {target: it, owner: it.owner}))",
              "set(locked, true)"
            ]
          },
          {
            "name": "Roll damage",
            "when": "locked and damage = empty",
            "steps": ["roll(8d6) -> damage"]
          },
          {
            "name": "Apply all",
            "when": "locked and damage != empty and all(rows.save_roll != empty) and not applied",
            "steps": [
              "each(rows, add(it.target.damage_taken, it.damage_dealt))",
              "set(applied, true)"
            ]
          },
          {
            "name": "Discard",
            "steps": ["remove(zone)", "remove(this)"]
          }
        ]
      },
      {
        "id": "fireball_zone",
        "note": "A circle zone of radius 4, held in the card template's contents, so it has no placement.",
        "is_zone": true,
        "tag": ["fireball_zone"],
        "shape": {
          "type": "circle",
          "radius": 4
        },
        "cells": {
          "name": {
            "type": "text",
            "value": "Fireball area"
          }
        }
      },
      {
        "id": "save_row_t",
        "note": "Outside the card's subtree (beside it in the binder): inside, it would be copied with the card and match the card's own rows query (FIXTURES §9).",
        "is_template": true,
        "tag": ["save_row"],
        "cells": {
          "name": {
            "type": "text",
            "value": "Save row"
          },
          "target": {
            "type": "empty"
          },
          "save_roll": {
            "type": "empty"
          },
          "card": {
            "type": "formula",
            "source": "container"
          },
          "save_bonus": {
            "type": "formula",
            "source": "target.dex_save"
          },
          "passed": {
            "type": "formula",
            "source": "save_roll + save_bonus >= card.dc"
          },
          "damage_dealt": {
            "type": "formula",
            "source": "if(passed, floor(card.damage / 2), card.damage)"
          }
        },
        "actions": [
          {
            "name": "Roll save",
            "when": "save_roll = empty",
            "steps": ["roll(1d20) -> save_roll"]
          }
        ]
      }
    ]
  },
  "dice": [
    {
      "type": "roll",
      "expr": "8d6",
      "dice": [3, 5, 2, 6, 4, 1, 5, 1],
      "dropped": [],
      "total": 27
    },
    {
      "type": "roll",
      "expr": "1d20",
      "dice": [13],
      "dropped": [],
      "total": 13
    },
    {
