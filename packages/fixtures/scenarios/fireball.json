          "object": "row_g1",
          "cell": "target",
          "value": {
            "type": "ref",
            "object": "goblin1"
          },
          "note": "{target: it, ...}: the row's target is the creature it was spawned for."
        },
        {
          "type": "cell",
          "object": "row_g1",
          "cell": "owner",
          "value": {
            "type": "ref",
            "object": "goblin1"
          },
          "note": "{..., owner: it.owner}: the creature's owner, here the creature itself."
        },
        {
          "type": "cell",
          "object": "row_g1",
          "cell": "template",
          "value": {
            "type": "ref",
            "object": "save_row_t"
          },
          "note": "spawn sets template (FORMULAS §8.3)."
