        {
          "type": "cell",
          "object": "row_g1",
          "cell": "card",
          "value": {
            "type": "ref",
            "object": "fb1"
          },
          "note": "card = container."
        },
        {
          "type": "cell",
          "object": "row_g1",
          "cell": "save_bonus",
          "value": {
            "type": "number",
            "value": 2
          },
          "note": "save_bonus = target.dex_save; goblin1's dex_save is 2."
        },
        {
